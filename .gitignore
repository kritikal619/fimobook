# Firebase admin keys
/instance/*.json
/instance/*.db
/instance/.secret_key
/*firebase-adminsdk*.json
**/*firebase-adminsdk*.json

# Android/TWA local build outputs and signing material
/android/.gradle/
/android/app/build/
/android/build/
/android/local.properties
/android/*.keystore
/android/*.jks
/android/app-release-*.apk
/android/app-release-*.aab

# Python bytecode and macOS metadata
__pycache__/
*.pyc
.DS_Store

# Generated local caches
/instance/player_thumbnails/
/instance/derived_statistics/

# Local Claude Code session state
/.claude/

# Downloaded or generated game assets. Production keeps its own copies; restore
# with scripts/ensure_player_images.py, scripts/sync_fctimes_assets.py and the
# other sync/build scripts instead of committing them (already tracked files stay).
/static/card/
/static/faceon/
/static/pack-opener/
/static/ranking/
/static/times/

# Local work logs and deployment snapshots (contain production paths and source copies)
/artifacts/
/reports/
